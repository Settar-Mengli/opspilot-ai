# OpsPilot AI — environment template (B2). Never commit real secrets.

# --- Postgres (local Docker Compose) ---
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@127.0.0.1:5432/opspilot

# --- Policy / hermetic ---
# TESTS/CI ONLY: force rule-based triage and soft LLM paths (never set in deploy).
# OPSPILOT_FORCE_RULES=1
# Disable all remote LLM (soft/rules fallbacks).
# OPSPILOT_LLM_DISABLE=1
# Include full validation error payloads (F-03). Default off.
# OPSPILOT_DEBUG_ERRORS=0

# --- Free-tier inference (default path) ---
INFERENCE_PROVIDER_ORDER=gemini,groq,mistral,cloudflare,openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional per-task overrides: GEMINI_MODEL_ASK / _TRIAGE / _EVENING / _INSIGHTS / _BRIEFING

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: GROQ_MODEL_TRIAGE, GROQ_MODEL_ASK, ...

MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-3b-2512

OPENROUTER_API_KEY=
# Approved free model (must keep :free suffix; unpaid is_free_tier=true).
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Default off. Set to 1 only if intentionally using a paid OpenRouter model.
# OPSPILOT_OPENROUTER_ALLOW_PAID=0

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Daily budgets (UTC). Unset = deny remote for that provider. ---
# Owner-approved 2026-09-29 (PART 7). Mix of floor(0.8×measured) and OWNER POLICY caps.
# See docs/runbooks/llm-providers.md for sources, Pacific skew, Cloudflare neuron→token.
OPSPILOT_BUDGET_GEMINI_REQ_DAY=400
OPSPILOT_BUDGET_GEMINI_TOK_DAY=800000
OPSPILOT_BUDGET_GROQ_REQ_DAY=800
OPSPILOT_BUDGET_GROQ_TOK_DAY=160000
OPSPILOT_BUDGET_MISTRAL_REQ_DAY=1000
OPSPILOT_BUDGET_MISTRAL_TOK_DAY=1000000
OPSPILOT_BUDGET_CLOUDFLARE_REQ_DAY=80
OPSPILOT_BUDGET_CLOUDFLARE_TOK_DAY=140000
OPSPILOT_BUDGET_OPENROUTER_REQ_DAY=40
OPSPILOT_BUDGET_OPENROUTER_TOK_DAY=160000
# Ollama: leave unset (local optional).
# OPSPILOT_BUDGET_OLLAMA_REQ_DAY=
# OPSPILOT_BUDGET_OLLAMA_TOK_DAY=

# --- Anthropic prepaid gate (D-023). Default off. Never visitor Ask. ---
OPSPILOT_ANTHROPIC_ENABLED=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPSPILOT_ANTHROPIC_BUDGET_TOKENS=
# OPSPILOT_ANTHROPIC_BUDGET_USD=
# Required when enabled (VERIFY AT DECISION TIME against Anthropic pricing):
# OPSPILOT_ANTHROPIC_USD_PER_MTOK_IN=
# OPSPILOT_ANTHROPIC_USD_PER_MTOK_OUT=

# --- Observability ---
# OPSPILOT_LLM_JSONL=1
# OPSPILOT_LLM_TRACE_DIR=data/llm_traces
# OPSPILOT_LLM_CIRCUIT_OPEN_SECONDS=300

# --- Google OAuth + DEMO (B4). Never commit real secrets. ---
# Use 127.0.0.1 (not localhost) for FE and API so the operator cookie works (A1).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/oauth/google/callback
# TOKEN_ENCRYPTION_KEY=   # Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OPSPILOT_SESSION_SECRET=  # long random; signs opspilot_operator cookie
OPSPILOT_DEMO_MODE=0
# B5 HITL send: comma-separated recipients; unset/empty = deny all sends (D-033).
# OPSPILOT_SEND_RECIPIENT_ALLOWLIST=demo@example.com
# Ask agent caps (defaults 5 / 8)
# OPSPILOT_ASK_MAX_STEPS=5
# OPSPILOT_ASK_MAX_PROVIDER_CALLS=8
# Max untriaged gmail items to classify per Sync now / connected POST /runs (G6). Default 10.
# OPSPILOT_SYNC_TRIAGE_CAP=10

# Retired (do not use): OPSPILOT_AI_API_KEY / OPSPILOT_AI_PROVIDER / OPSPILOT_AI_MODEL
