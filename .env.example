# Backend environment variables
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# New unified provider config (takes precedence over ANTHROPIC_API_KEY)
OPSPILOT_AI_PROVIDER=anthropic
OPSPILOT_AI_MODEL=claude-haiku-4-5-20251001
OPSPILOT_AI_API_KEY=

# Hermetic / offline triage: when set to 1/true/yes/on, the adapter factory
# always returns the rule-based adapter and never constructs the Anthropic client.
# Default: unset (off). Tests set this automatically; do not enable for normal demo runs.
# OPSPILOT_FORCE_RULES=1

# Local Postgres (Docker Compose). Async SQLAlchemy uses the same URL with +psycopg.
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@127.0.0.1:5432/opspilot
