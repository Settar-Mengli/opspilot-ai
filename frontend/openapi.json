  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "assistant_name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9 .'\\-]+$",
            "title": "Assistant Name",
            "default": "OpsPilot"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "EveningSummaryRequest": {
        "properties": {
          "assistant_name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9 .'\\-]+$",
            "title": "Assistant Name",
            "default": "OpsPilot"
          }
        },
        "type": "object",
        "title": "EveningSummaryRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InsightsRequest": {
        "properties": {
          "assistant_name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9 .'\\-]+$",
            "title": "Assistant Name",
            "default": "OpsPilot"
          }
        },
        "type": "object",
        "title": "InsightsRequest"
      },
      "RunPipelineRequest": {
        "properties": {
          "input_file": {
            "type": "string",
            "title": "Input File",
            "default": "sample_input.json"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          }
        },
        "type": "object",
        "required": [
          "date"
        ],
        "title": "RunPipelineRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
