  "components": {
    "schemas": {
      "AskHistoryTurn": {
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^(user|assistant|system)$",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "AskHistoryTurn"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "assistant_name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9 .'\\-]+$",
            "title": "Assistant Name",
            "default": "OpsPilot"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/AskHistoryTurn"
            },
            "type": "array",
            "maxItems": 10,
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
